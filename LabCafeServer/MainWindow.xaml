<Window x:Class="LabCafeServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Server Dashboard" Height="720" Width="1280"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D2D30">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="SERVER SYSTEM" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button x:Name="BtnDashboard" Content="Dashboard" Click="BtnDashboard_Click" Height="50" Background="Transparent" Foreground="LightGray" FontSize="16" BorderThickness="0"/>
                <Button x:Name="BtnUserManagement" Content="User Management" Click="BtnUserManagement_Click" Height="50" Background="Transparent" Foreground="LightGray" FontSize="16" BorderThickness="0"/>
                <Button x:Name="BtnFileManagement" Content="File Management" Click="BtnFileManagement_Click" Height="50" Background="Transparent" Foreground="LightGray" FontSize="16" BorderThickness="0"/>
                <Button x:Name="BtnRestrictions" Content="Restrictions" Click="BtnRestrictions_Click" Height="50" Background="Transparent" Foreground="LightGray" FontSize="16" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>