<UserControl x:Class="LabCafeServer.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0" Foreground="White">

            <TabItem Header="BATCH PROVISIONING" FontSize="16" FontWeight="Bold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Master Workspace Path:" Foreground="LightGray" VerticalAlignment="Center" Width="180"/>
                        <TextBox x:Name="TxtWorkspacePath" Text="C:\LabWorkspaces" Width="300" Height="30" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3E3E42" Padding="5"/>
                        <Button x:Name="BtnBrowse" Content="Browse..." Click="BtnBrowse_Click" Width="80" Height="30" Margin="10,0,0,0" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Target Section:" Foreground="LightGray" VerticalAlignment="Center" Width="180"/>
                        <TextBox x:Name="TxtSection" Width="300" Height="30" Background="#2D2D30" Foreground="White" BorderThickness="1" BorderBrush="#3E3E42" Padding="5"/>
                    </StackPanel>

                    <DataGrid x:Name="GridBatchStudents" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="True" Background="#2D2D30" Foreground="Black" RowBackground="White" AlternatingRowBackground="#E5E5E5" HeadersVisibility="Column" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student ID" Binding="{Binding ID}" Width="120"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="150"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="150"/>
                            <DataGridTextColumn Header="Generated Username" Binding="{Binding Username}" Width="180" IsReadOnly="True" CellStyle="{StaticResource {x:Type DataGridCell}}"/>
                            <DataGridTextColumn Header="Default Password" Binding="{Binding Password}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <TextBlock x:Name="TxtBatchStatus" Text="Ready to provision..." Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button x:Name="BtnProvisionBatch" Content="Execute Batch Provision" Click="BtnProvisionBatch_Click" Height="40" Width="200" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="JSON DATABASE DIRECTORY" FontSize="16" FontWeight="Bold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridUsers" Grid.Row="0" AutoGenerateColumns="True" Background="#2D2D30" Foreground="Black" RowBackground="White" AlternatingRowBackground="#E5E5E5" HeadersVisibility="Column" IsReadOnly="True" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtDirectoryStatus" Text="Ready..." Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button x:Name="BtnRefreshUsers" Content="Refresh Database" Click="BtnRefreshUsers_Click" Height="35" Width="150" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>
                        <Button x:Name="BtnResetPassword" Content="Reset Default Password" Click="BtnResetPassword_Click" Height="35" Width="180" Background="#D97706" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDeleteUser" Content="Delete Student" Click="BtnDeleteUser_Click" Height="35" Width="120" Background="#FF3333" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>